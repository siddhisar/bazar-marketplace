# Server
PORT=5000

# PostgreSQL connection URL. Placeholders only — never commit real credentials.
#
# Local development:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/thread
#
# Supabase. Take the string from Dashboard -> Project Settings -> Database ->
# Connection string, and URL-encode any special characters in the password.
# Use the Session Pooler (port 5432) unless the backend runs somewhere that
# opens a connection per request, in which case use the Transaction Pooler
# (port 6543).
#
# `uselibpqcompat=true` is required. Without it node-postgres reads
# sslmode=require as verify-full and rejects the pooler's certificate chain
# with SELF_SIGNED_CERT_IN_CHAIN. With it, the connection is still encrypted
# and the mode means what it means in libpq and psql.
#   DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-value

# Supabase Storage — where listing photos live.
#
# `listing_photos.path` stays in its `/images/...` form regardless; these only
# decide whether the backend serves those bytes from local disk or redirects to
# the bucket. IMAGE_STORAGE defaults to "supabase" whenever SUPABASE_URL is set,
# because a deployed backend has no uploads/ folder to read from.
#   IMAGE_STORAGE=local | supabase
IMAGE_STORAGE=
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_STORAGE_BUCKET=listing-photos
# Secret key from Dashboard -> Settings -> API Keys -> Secret keys.
# Bypasses row-level security: backend only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pexels API key, for `npm run images:pexels` — fetches the relevant listing
# images the seed assigns. Free and instant at https://www.pexels.com/api/.
# Only needed when (re)fetching images; not needed to run the app.
PEXELS_API_KEY=

# Google OAuth 2.0 (console.cloud.google.com -> Credentials -> OAuth client ID).
# Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
# Leave blank to disable the Continue with Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
